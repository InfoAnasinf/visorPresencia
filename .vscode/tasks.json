{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Pytest",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "-m",
                "pytest",
                "tests"
            ],
            "group": "test",
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": "$pytest"
        },
        {
            "label": "Lint with Ruff",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "-m",
                "ruff",
                "check",
                "."
            ],
            "group": "build",
            "problemMatcher": []
        }
    ]
}
